<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Pouzinho — Seu Bicho Virtual</title>
  <style>
    :root {
      --bg: #070b14;
      --surface: #111827;
      --surface-2: #182234;
      --surface-3: #223049;
      --text: #f8fafc;
      --muted: #94a3b8;
      --green: #22c55e;
      --green-dark: #15803d;
      --gold: #fbbf24;
      --pink: #f472b6;
      --cyan: #38bdf8;
      --purple: #a855f7;
      --border: rgba(148, 163, 184, 0.16);
      --radius: 18px;
    }

    * {
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
      user-select: none;
    }

    body {
      margin: 0;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: radial-gradient(circle at 50% -10%, #172542 0%, var(--bg) 55%);
      color: var(--text);
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
    }

    .app {
      width: 100%;
      max-width: 540px;
      margin: 0 auto;
      padding: 12px 14px 28px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    /* Topo */
    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 10px 14px;
      background: rgba(17, 24, 39, 0.88);
      backdrop-filter: blur(10px);
      border: 1px solid var(--border);
      border-radius: 16px;
      position: sticky;
      top: 10px;
      z-index: 20;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 8px;
      font-weight: 900;
      font-size: 1rem;
      letter-spacing: 0.2px;
    }

    .brand-badge {
      background: linear-gradient(135deg, var(--green), var(--cyan));
      color: #04130b;
      font-size: 0.7rem;
      font-weight: 900;
      padding: 2px 7px;
      border-radius: 999px;
    }

    .coins-pill {
      display: flex;
      align-items: center;
      gap: 6px;
      background: linear-gradient(135deg, rgba(251, 191, 36, 0.18), rgba(245, 158, 11, 0.08));
      border: 1px solid rgba(251, 191, 36, 0.45);
      color: #fde68a;
      padding: 6px 12px;
      border-radius: 999px;
      font-weight: 900;
      font-size: 0.9rem;
    }

    /* Cartão principal do bicho */
    .pet-card {
      background: linear-gradient(180deg, #152035 0%, var(--surface) 100%);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 14px;
      box-shadow: 0 16px 36px rgba(0, 0, 0, 0.35);
    }

    .pet-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      margin-bottom: 12px;
    }

    .pet-identity {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .pet-name {
      font-size: 1.08rem;
      font-weight: 900;
    }

    .lvl-pill {
      background: var(--surface-3);
      border: 1px solid var(--border);
