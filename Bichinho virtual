<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Bicho Virtual — Pocket Pet</title>
  <style>
    :root {
      --bg: #080d18;
      --card: #111927;
      --card-2: #1a2436;
      --text: #f9fafb;
      --muted: #9ca3af;
      --accent: #22c55e;
      --gold: #f59e0b;
      --blue: #38bdf8;
      --pink: #f472b6;
      --border: #273449;
    }

    * {
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
      user-select: none;
    }

    body {
      margin: 0;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
    }

    header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 14px;
      background: var(--card);
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      z-index: 10;
    }

    .brand {
      font-weight: 900;
      font-size: 1rem;
    }

    .hud-top {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 0.84rem;
      font-weight: 800;
    }

    .pill {
      background: var(--card-2);
      border: 1px solid var(--border);
      padding: 5px 10px;
      border-radius: 999px;
    }

    .vip-badge {
      background: var(--gold);
      color: #111827;
      padding: 2px 7px;
      border-radius: 999px;
      font-size: 0.72rem;
      font-weight: 900;
      display: none;
    }

    .vip-badge.active {
      display: inline-block;
    }

    nav.tabs {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      background: var(--card);
      border-bottom: 1px solid var(--border);
    }

    nav.tabs button {
      background: transparent;
      border: none;
      color: var(--muted);
      padding: 12px 6px;
      font-weight: 800;
      font-size: 0.88rem;
      border-bottom: 3px solid transparent;
      cursor: pointer;
    }

    nav.tabs button.active {
      color: var(--text);
      border-bottom-color: var(--accent);
      background: rgba(34, 197, 94, 0.08);
    }

    main {
      flex: 1;
      width: 100%;
      max-width: 560px;
      margin: 0 auto;
      padding: 14px;
    }

    .panel-tab {
      display: none;
    }

    .panel-tab.active {
      display: block;
    }

    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 14px;
      margin-bottom: 14px;
    }

    .pet-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 10px;
      gap: 8px;
    }

    .pet-title {
      font-size: 1.05rem;
      font-weight: 900;
    }

    .pet-mood {
      font-size: 0.82rem;
      color: #86efac;
      font-weight: 700;
    }

    .meters {
      display: grid;
      gap: 8px;
      margin-bottom: 12px;
    }

    .meter-row {
      background: var(--card-2);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 8px 10px;
    }

    .meter-top {
      display: flex;
      justify-content: space-between;
      font-size: 0.8rem;
      font-weight: 800;
      margin-bottom: 5px;
    }

    .bar-bg {
      height: 8px;
      background: #0b101b;
      border-radius: 999px;
      overflow: hidden;
    }

    .bar-fill {
      height: 100%;
      width: 80%;
      border-radius: 999px;
      transition: width 0.25s ease;
    }

    .stage-wrap {
      display: flex;
      justify-content: center;
      margin-bottom: 12px;
    }

    canvas#petStage {
      width: 100%;
      max-width: 390px;
      aspect-ratio: 4 / 3;
      background: radial-gradient(circle at top, #17253b, #090e1a 75%);
      border: 1px solid var(--border);
      border-radius: 14px;
      touch-action: manipulation;
      box-shadow: 0 12px 26px rgba(0, 0, 0, 0.42);
    }

    .actions-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
    }

    .btn {
      background: var(--accent);
      color: #052e16;
      border: none;
      border-radius: 10px;
      padding: 11px 10px;
      font-weight: 900;
      font-size: 0.86rem;
      cursor: pointer;
    }

    .btn.secondary {
      background: var(--card-2);
      color: var(--text);
      border: 1px solid var(--border);
    }

    .btn.gold {
      background: var(--gold);
      color: #111827;
    }

    .row {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    h2 {
      margin: 0 0 6px;
      font-size: 1.05rem;
    }

    p.hint {
      margin: 0 0 12px;
      color: var(--muted);
      font-size: 0.86rem;
      line-height: 1.4;
    }

    input.field {
      width: 100%;
      background: var(--bg);
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 10px 12px;
      font-size: 0.9rem;
      margin-bottom: 10px;
    }

    .pix-box {
      background: var(--bg);
      border: 1px dashed var(--border);
      border-radius: 10px;
      padding: 10px 12px;
      font-size: 0.84rem;
      color: #e5e7eb;
      word-break: break-all;
      margin-bottom: 10px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.88rem;
    }

    th, td {
      padding: 9px 6px;
      border-bottom: 1px solid var(--border);
      text-align: left;
    }

    .toast {
      position: fixed;
      bottom: 18px;
      left: 50%;
      transform: translateX(-50%);
      background: #030712;
      color: var(--text);
      border: 1px solid var(--accent);
      padding: 10px 16px;
      border-radius: 999px;
      font-size: 0.84rem;
      font-weight: 800;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s ease;
      z-index: 50;
    }

    .toast.show {
      opacity: 1;
    }
  </style>
</head>
<body>
  <header>
    <div class="brand">🐾 Bicho Virtual</div>
    <div class="hud-top">
      <div class="pill">🪙 <span id="coinsVal">50</span></div>
      <span id="vipBadge" class="vip-badge">VIP</span>
    </div>
  </header>

  <nav class="tabs">
    <button class="active" data-tab="petTab">Meu Bicho</button>
    <button data-tab="rankTab">Progresso</button>
    <button data-tab="pixTab">Pix & VIP</button>
  </nav>

  <main>
    <!-- MEU BICHO -->
    <section id="petTab" class="panel-tab active">
      <div class="card">
        <div class="pet-header">
          <div class="pet-title" id="petNameDisplay">Mochi • Nv. 1</div>
          <div class="pet-mood" id="petMoodText">Animado e pronto para brincar!</div>
        </div>

        <div class="meters">
          <div class="meter-row">
            <div class="meter-top"><span>🍖 Alimentação</span><span id="hungerTxt">80%</span></div>
            <div class="bar-bg"><div class="bar-fill" id="hungerBar" style="background:#22c55e;"></div></div>
          </div>
          <div class="meter-row">
            <div class="meter-top"><span>🎾 Felicidade</span><span id="happyTxt">80%</span></div>
            <div class="bar-bg"><div class="bar-fill" id="happyBar" style="background:#f472b6;"></div></div>
          </div>
          <div class="meter-row">
            <div class="meter-top"><span>⚡ Energia</span><span id="energyTxt">80%</span></div>
            <div class="bar-bg"><div class="bar-fill" id="energyBar" style="background:#38bdf8;"></div></div>
          </div>
        </div>

        <div class="stage-wrap">
          <canvas id="petStage" width="380" height="285"></canvas>
        </div>

        <div class="actions-grid">
          <button class="btn" id="feedBtn">🍖 Alimentar (-5 🪙)</button>
          <button class="btn gold" id="playBtn">🎾 Brincar (+8 🪙)</button>
          <button class="btn secondary" id="sleepBtn">💤 Dormir</button>
        </div>
      </div>
    </section>

    <!-- PROGRESSO -->
    <section id="rankTab" class="panel-tab">
      <div class="card">
        <h2>Nome do Bicho Virtual</h2>
        <p class="hint">Escolha como chamar o seu bichinho.</p>
        <input class="field" id="petNameInput" type="text" maxlength="16" placeholder="Ex.: Mochi, Pipoca, Rex" />
        <button class="btn" id="savePetNameBtn">Salvar Nome</button>
      </div>

      <div class="card">
        <h2>Resumo do Bicho</h2>
        <p class="hint">Nível, cuidados feitos e fichas acumuladas neste aparelho.</p>
        <table>
          <thead>
            <tr>
              <th>Bicho</th>
              <th>Nível</th>
              <th>Cuidados</th>
              <th>Fichas</th>
            </tr>
          </thead>
          <tbody id="summaryBody"></tbody>
        </table>
      </div>
    </section>

    <!-- PIX & VIP -->
    <section id="pixTab" class="panel-tab">
      <div class="card">
        <h2>Receber via Pix</h2>
        <p class="hint">Sua chave Pix para receber pagamentos ou apoios.</p>
        <div class="pix-box" id="pixText"></div>
        <input class="field" id="pixEdit" type="text" placeholder="Chave Pix" />
        <div class="row">
          <button class="btn" id="copyPixBtn">Copiar Pix</button>
          <button class="btn secondary" id="savePixBtn">Salvar Chave</button>
        </div>
      </div>

      <div class="card">
        <h2>Liberar VIP ou Fichas</h2>
        <p class="hint">Após confirmar o pagamento, digite o código de liberação (padrão: <strong>GO2026</strong>). Com VIP, brincar rende o dobro de fichas!</p>
        <input class="field" id="unlockInput" type="text" placeholder="Digite GO2026" />
        <div class="row">
          <button class="btn gold" id="vipBtn">Liberar VIP</button>
          <button class="btn" id="coinsBtn">+150 Fichas</button>
        </div>
      </div>
    </section>
  </main>

  <div class="toast" id="toast"></div>

  <script>
    const PIX_DEFAULT = "e2dd5b9e-de3b-4a07-a14e-76172ed64a3a";
    const CODE_DEFAULT = "GO2026";
    const STORAGE_KEY = "bicho_virtual_save_v1";

    const petState = loadPet();
    let hopOffset = 0;
    let hopVel = 0;
    let blinkTimer = 0;
    let breathTick = 0;
    let sleeping = false;
    let hearts = [];

    function clamp(v, min, max) {
      return Math.max(min, Math.min(max, v));
    }

    function loadPet() {
      const def = {
        petName: "Mochi",
        coins: 50,
        xp: 0,
        actionsCount: 0,
        hunger: 80,
        happy: 80,
        energy: 80,
        vip: false,
        pix: PIX_DEFAULT
      };
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        return raw ? { ...def, ...JSON.parse(raw) } : def;
      } catch {
        return def;
      }
    }

    function savePet() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(petState));
      } catch {}
      renderAll();
    }

    function toast(msg) {
      const t = document.getElementById("toast");
      t.textContent = msg;
      t.classList.add("show");
      clearTimeout(window.__toastTimer);
      window.__toastTimer = setTimeout(() => t.classList.remove("show"), 2200);
    }

    function escapeHtml(str) {
      return String(str).replace(/[&<>"']/g, (m) => ({
        "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;"
      }[m]));
    }

    // Abas
    document.querySelectorAll("nav.tabs button").forEach((btn) => {
      btn.addEventListener("click", () => {
        document.querySelectorAll("nav.tabs button").forEach((b) => b.classList.remove("active"));
        document.querySelectorAll(".panel-tab").forEach((p) => p.classList.remove("active"));
        btn.classList.add("active");
        document.getElementById(btn.dataset.tab).classList.add("active");
      });
    });

    function getLevel() {
      return 1 + Math.floor(petState.xp / 50);
    }

    function getMoodLabel() {
      if (sleeping) return "Dormindo... recarregando energia 💤";
      if (petState.hunger < 25) return "Com muita fome! 🍖";
      if (petState.energy < 25) return "Cansado, hora de descansar ⚡";
      if (petState.happy >= 75) return "Super feliz e animado! ✨";
      return "De boa, toque para dar carinho!";
    }

    function spawnHeart(x, y) {
      hearts.push({ x, y, alpha: 1, vy: -1.1 });
    }

    function renderAll() {
      const lv = getLevel();
      document.getElementById("coinsVal").textContent = petState.coins;
      document.getElementById("vipBadge").classList.toggle("active", Boolean(petState.vip));
      document.getElementById("petNameDisplay").textContent = `${petState.petName} • Nv. ${lv}`;
      document.getElementById("petMoodText").textContent = getMoodLabel();

      const h = Math.round(petState.hunger);
      const hp = Math.round(petState.happy);
      const en = Math.round(petState.energy);

      document.getElementById("hungerTxt").textContent = h + "%";
      document.getElementById("happyTxt").textContent = hp + "%";
      document.getElementById("energyTxt").textContent = en + "%";

      document.getElementById("hungerBar").style.width = h + "%";
      document.getElementById("happyBar").style.width = hp + "%";
      document.getElementById("energyBar").style.width = en + "%";

      document.getElementById("petNameInput").value = petState.petName;
      document.getElementById("pixEdit").value = petState.pix;
      document.getElementById("pixText").textContent = "Chave Pix: " + petState.pix;

      document.getElementById("summaryBody").innerHTML = `
        <tr>
          <td>${escapeHtml(petState.petName)}</td>
          <td>Nv. ${lv}</td>
          <td>${petState.actionsCount}</td>
          <td>${petState.coins}</td>
        </tr>`;
    }

    // Ações do Bicho Virtual
    document.getElementById("feedBtn").addEventListener("click", () => {
      if (petState.coins < 5) {
        toast("Sem fichas suficientes! Brinque para ganhar.");
        return;
      }
      sleeping = false;
      petState.coins -= 5;
      petState.hunger = clamp(petState.hunger + 25, 0, 100);
      petState.happy = clamp(petState.happy + 5, 0, 100);
      petState.xp += 10;
      petState.actionsCount += 1;
      hopVel = -7;
      spawnHeart(190, 110);
      savePet();
      toast(`${petState.petName} comeu e adorou! 🍖`);
    });

    document.getElementById("playBtn").addEventListener("click", () => {
      if (petState.energy < 15) {
        toast(`${petState.petName} está sem energia! Coloque para dormir.`);
        return;
      }
      sleeping = false;
      const reward = petState.vip ? 16 : 8;
      petState.coins += reward;
      petState.happy = clamp(petState.happy + 22, 0, 100);
      petState.energy = clamp(petState.energy - 18, 0, 100);
      petState.hunger = clamp(petState.hunger - 10, 0, 100);
      petState.xp += 15;
      petState.actionsCount += 1;
      hopVel = -10;
      spawnHeart(190, 100);
      savePet();
      toast(`Brincou muito! +${reward} fichas 🎾`);
    });

    document.getElementById("sleepBtn").addEventListener("click", () => {
      sleeping = !sleeping;
      if (sleeping) {
        petState.energy = clamp(petState.energy + 30, 0, 100);
        petState.xp += 8;
        petState.actionsCount += 1;
        savePet();
        toast(`${petState.petName} foi dormir 💤`);
      } else {
        renderAll();
        toast(`${petState.petName} acordou!`);
      }
    });

    // Degradação suave com o tempo
    setInterval(() => {
      if (sleeping) {
        petState.energy = clamp(petState.energy + 3, 0, 100);
        petState.happy = clamp(petState.happy + 1, 0, 100);
      } else {
        petState.hunger = clamp(petState.hunger - 2, 0, 100);
        petState.happy = clamp(petState.happy - 2, 0, 100);
        petState.energy = clamp(petState.energy - 1.5, 0, 100);
      }
      savePet();
    }, 6000);

    // Palco animado do Bicho Virtual
    const stage = document.getElementById("petStage");
    const sctx = stage.getContext("2d");

    stage.addEventListener("click", () => {
      sleeping = false;
      hopVel = -8;
      petState.happy = clamp(petState.happy + 4, 0, 100);
      petState.xp += 3;
      spawnHeart(stage.width / 2, stage.height / 2 - 35);
      savePet();
    });

    function drawPet() {
      sctx.clearRect(0, 0, stage.width, stage.height);

      // Chão
      sctx.fillStyle = "rgba(15, 23, 42, 0.7)";
      sctx.beginPath();
      sctx.ellipse(stage.width / 2, stage.height - 34, 115, 18, 0, 0, Math.PI * 2);
      sctx.fill();

      // Respiração suave + pulo
      breathTick += 0.06;
      const breathOffset = sleeping ? Math.sin(breathTick * 0.7) * 2.5 : Math.sin(breathTick) * 3.5;

      hopOffset += hopVel;
      hopVel += 0.55;
      if (hopOffset >= 0) {
        hopOffset = 0;
        hopVel = 0;
      }

      const cx = stage.width / 2;
      const cy = stage.height / 2 + 12 + hopOffset + breathOffset;

      // Orelhas
      sctx.fillStyle = petState.vip ? "#38bdf8" : "#f472b6";
      sctx.beginPath();
      sctx.ellipse(cx - 42, cy - 52, 16, 30, -0.35, 0, Math.PI * 2);
      sctx.ellipse(cx + 42, cy - 52, 16, 30, 0.35, 0, Math.PI * 2);
      sctx.fill();

      // Corpo / Cabeça
      sctx.fillStyle = petState.vip ? "#7dd3fc" : "#fbcfe8";
      sctx.beginPath();
      sctx.arc(cx, cy, 58, 0, Math.PI * 2);
      sctx.fill();
      sctx.lineWidth = 3;
      sctx.strokeStyle = "#ffffff";
      sctx.stroke();

      // Bochechas
      sctx.fillStyle = "rgba(244, 63, 94, 0.35)";
      sctx.beginPath();
      sctx.arc(cx - 28, cy + 8, 9, 0, Math.PI * 2);
      sctx.arc(cx + 28, cy + 8, 9, 0, Math.PI * 2);
      sctx.fill();

      // Olhos
      blinkTimer++;
      const isBlinking = sleeping || (blinkTimer % 150 > 142);
      sctx.strokeStyle = "#0f172a";
      sctx.fillStyle = "#0f172a";
      sctx.lineWidth = 3;

      if (isBlinking) {
        sctx.beginPath();
        sctx.moveTo(cx - 26, cy - 6);
        sctx.lineTo(cx - 12, cy - 6);
        sctx.moveTo(cx + 12, cy - 6);
        sctx.lineTo(cx + 26, cy - 6);
        sctx.stroke();
      } else {
        sctx.beginPath();
        sctx.arc(cx - 19, cy - 8, 6.5, 0, Math.PI * 2);
        sctx.arc(cx + 19, cy - 8, 6.5, 0, Math.PI * 2);
        sctx.fill();

        sctx.fillStyle = "#ffffff";
        sctx.beginPath();
        sctx.arc(cx - 21, cy - 10, 2.2, 0, Math.PI * 2);
        sctx.arc(cx + 17, cy - 10, 2.2, 0, Math.PI * 2);
        sctx.fill();
      }

      // Boca
      sctx.strokeStyle = "#0f172a";
      sctx.lineWidth = 2.8;
      sctx.beginPath();
      if (petState.happy >= 40 && !sleeping) {
        sctx.arc(cx, cy + 6, 12, 0.15 * Math.PI, 0.85 * Math.PI);
      } else {
        sctx.moveTo(cx - 8, cy + 12);
        sctx.lineTo(cx + 8, cy + 12);
      }
      sctx.stroke();

      // Corações ao tocar / cuidar
      for (let i = hearts.length - 1; i >= 0; i--) {
        const h = hearts[i];
        h.y += h.vy;
        h.alpha -= 0.022;
        if (h.alpha <= 0) {
          hearts.splice(i, 1);
          continue;
        }
        sctx.save();
        sctx.globalAlpha = Math.max(0, h.alpha);
        sctx.fillStyle = "#f472b6";
        sctx.font = "800 18px system-ui, sans-serif";
        sctx.textAlign = "center";
        sctx.fillText("♥", h.x, h.y);
        sctx.restore();
      }

      // Zzz quando dormindo
      if (sleeping) {
        sctx.fillStyle = "#bae6fd";
        sctx.font = "800 16px system-ui, sans-serif";
        sctx.fillText("Zzz...", cx + 48, cy - 42);
      }
    }

    function animate() {
      drawPet();
      requestAnimationFrame(animate);
    }

    // Nome, Progresso & Pix
    document.getElementById("savePetNameBtn").addEventListener("click", () => {
      petState.petName = document.getElementById("petNameInput").value.trim() || "Mochi";
      savePet();
      toast("Nome salvo!");
    });

    document.getElementById("savePixBtn").addEventListener("click", () => {
      petState.pix = document.getElementById("pixEdit").value.trim() || PIX_DEFAULT;
      savePet();
      toast("Chave Pix salva!");
    });

    document.getElementById("copyPixBtn").addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(petState.pix);
        toast("Chave Pix copiada!");
      } catch {
        toast("Copie a chave no campo acima.");
      }
    });

    function verifyCode() {
      const code = document.getElementById("unlockInput").value.trim().toUpperCase();
      if (code !== CODE_DEFAULT) {
        toast("Código inválido");
        return false;
      }
      document.getElementById("unlockInput").value = "";
      return true;
    }

    document.getElementById("vipBtn").addEventListener("click", () => {
      if (!verifyCode()) return;
      petState.vip = true;
      savePet();
      toast("VIP ativado! Brincar rende o dobro.");
    });

    document.getElementById("coinsBtn").addEventListener("click", () => {
      if (!verifyCode()) return;
      petState.coins += 150;
      savePet();
      toast("+150 fichas adicionadas!");
    });

    renderAll();
    animate();
  </script>
</body>
</html>
